    "seed": 42,
    "inference_temperature": null,
    "inference_top_k": null,
    "allow_missing_tasks": true,
    "extend_checkpoint_task_ids": true,
    "augmentation_sampling_mode": "single_grid_prefix"
  },
  "evals": {
