{
  "run_name": "arc2_variations_originals_big_batch_finetune",
  "dataset": {
    "dataset": "arc2",
    "style": "finetune",
    "pretrain_data": {
      "kind": "task_variations",
      "snapshot": "task-variations-v1",
      "sources": [
        "arc2_train",
        "conceptarc",
        "arc1_filtered"
      ],
      "original_sources": [
        "arc2_train",
        "conceptarc",
        "arc1_filtered"
      ],
      "sampling": {
        "variations_per_parent_per_epoch": 42,
        "seed_schedule": "shuffled_cycle",
        "target_pairs": "all_solved",
        "embedding_scope": "variation",
        "deduplicate_variation_inputs": false
      }
    }
  },
  "defaults": {
    "FA": 2,
    "epochs": 90,
    "batch_size": 96,
    "num_workers": null,
    "pin_memory": null,
