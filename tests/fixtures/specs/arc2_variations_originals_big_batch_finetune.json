    "normuon_fc_in_lr_floor": null,
    "normuon_fc_out_lr_floor": null,
    "normuon_example_value_latent_lr_floor": null,
    "normuon_other_lr_floor": null,
    "normuon_momentum": 0.95,
    "normuon_momentum_min": 0.85,
    "normuon_warmup_steps": 0,
    "normuon_cooldown_steps": 0,
    "normuon_beta2": 0.95,
    "normuon_bucket_size": 0,
    "adamw_lr": 0.00054,
    "adamw_decay_lr_multiplier": 1.0,
    "adamw_attention_lr_multiplier": 1.0,
    "adamw_token_embedding_lr_multiplier": 1.0,
    "adamw_task_factor_lr_multiplier": 1.0,
    "adamw_example_value_latent_lr_multiplier": 1.0,
    "adamw_no_decay_lr_multiplier": 1.0,
    "adamw_lr_floor": null,
    "adamw_decay_lr_floor": null,
    "adamw_attention_lr_floor": null,
    "adamw_token_embedding_lr_floor": null,
    "adamw_task_factor_lr_floor": null,
    "adamw_example_value_latent_lr_floor": null,
    "adamw_no_decay_lr_floor": null,
    "weight_decay": 0.1,
    "attention_weight_decay": 0.01,
    "token_embedding_weight_decay": 0.01,
    "task_embedding_weight_decay": 0.01,
    "grad_clip": 1.0,
    "dropout": 0.1,
    "embedding_dropout": 0.1,
    "attention_dropout": 0.1,
    "seed": 42,
    "device": "cuda",
    "d_model": 768,
    "n_heads": 12,
    "d_ff": 3072,
    "n_layers": 8,
    "num_task_embedding_latents": 3072,
    "inference_temperature": null,
    "inference_top_k": null,
    "warmup_pct": 0.005,
